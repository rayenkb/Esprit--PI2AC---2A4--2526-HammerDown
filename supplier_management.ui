 <connections>
  <connection>
   <sender>btn_help_gestion</sender>
   <signal>toggled(bool)</signal>
   <receiver>lbl_hint_gestion</receiver>
   <slot>setVisible(bool)</slot>
   <hints>
    <hint type="sourcelabel">
     <x>20</x>
     <y>20</y>
    </hint>
    <hint type="destinationlabel">
     <x>20</x>
     <y>20</y>
    </hint>
   </hints>
  </connection>
  <connection>
   <sender>btn_help_stats</sender>
   <signal>toggled(bool)</signal>
   <receiver>lbl_hint_stats</receiver>
   <slot>setVisible(bool)</slot>
   <hints>
